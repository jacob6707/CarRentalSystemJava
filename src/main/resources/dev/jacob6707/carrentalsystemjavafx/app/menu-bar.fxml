<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<MenuBar xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="dev.jacob6707.carrentalsystemjavafx.controller.MenuBarController"
         BorderPane.alignment="CENTER">
    <menus>
        <Menu mnemonicParsing="false" text="File">
            <items>
                <MenuItem mnemonicParsing="false" text="Backup Table" onAction="#backupTable" />
                <MenuItem mnemonicParsing="false" text="Restore Table" onAction="#restoreTable" />
                <MenuItem mnemonicParsing="false" text="Close" onAction="#closeApp" />
            </items>
        </Menu>
    </menus>
</MenuBar>
